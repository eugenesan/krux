+def _input_matches_seed(inp, seed, network, fingerprint=None):
+    """Whether the input contains a key derived from the seed."""
+    if fingerprint is None:
+        fingerprint = seed.get_fingerprint(network)
+    for pub, derivation in inp.bip32_derivations.items():
+        if derivation.fingerprint == b"\x00\x00\x00\x00":
+            root = __import__("embit.bip32", fromlist=["HDKey"]).HDKey.from_seed(
+                seed.seed_bytes,
+                version=__import__("embit.networks", fromlist=["NETWORKS"]).NETWORKS[
+                    network
+                ]["xprv"],
+            )
+            try:
+                if root.derive(derivation.derivation).key.sec() == pub.sec():
+                    return True
+            except Exception:
+                pass
+        else:
+            if derivation.fingerprint.hex() == fingerprint:
+                return True
+    for pub, (leaf_hashes, derivation) in inp.taproot_bip32_derivations.items():
+        if derivation.fingerprint == b"\x00\x00\x00\x00":
+            root = __import__("embit.bip32", fromlist=["HDKey"]).HDKey.from_seed(
+                seed.seed_bytes,
+                version=__import__("embit.networks", fromlist=["NETWORKS"]).NETWORKS[
+                    network
+                ]["xprv"],
+            )
+            try:
+                if root.derive(derivation.derivation).key.xonly() == pub.xonly():
+                    return True
+            except Exception:
+                pass
+        else:
+            if derivation.fingerprint.hex() == fingerprint:
+                return True
+    return False
