+def _screen_sighash_type(tx, seed, network):
+    """Hash type to show on the approval screen for a PSBT."""
+    requested = PSBTSigner.sighash_type(tx)
+    fingerprint = seed.get_fingerprint(network)
+
+    ours = [
+        inp for inp in tx.inputs if _input_matches_seed(inp, seed, network, fingerprint)
+    ]
+    if ours:
+        effective = {
+            (inp.sighash_type if inp.sighash_type is not None else requested)
+            for inp in ours
+        }
+        if len(effective) != 1:
+            return None, "mixed"
+        shown = effective.pop()
+        if shown not in PSBTSigner.SIGNABLE_SIGHASH_TYPES:
+            return None, "mixed"
