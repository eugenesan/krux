 diff --git a/tests/test_unified_sighash.py b/tests/test_unified_sighash.py
new file mode 100644
--- /dev/null
+++ b/tests/test_unified_sighash.py
@@ -0,0 +1,92 @@
+"""Krux integration tests for the unified opt-in sighash port."""
+from embit.transaction import SIGHASH
+
+
+def test_unified_constant_is_available():
+    assert SIGHASH.UNIFIED == 0x20
+
+
+def test_request_selection(tdata, m5stickv):
+    from embit.networks import NETWORKS
+    from krux.key import Key, TYPE_SINGLESIG
+    from krux.wallet import Wallet
+    from krux.psbt import PSBTSigner
+    from krux.qr import FORMAT_NONE
+
+    wallet = Wallet(Key(tdata.TEST_MNEMONIC, TYPE_SINGLESIG, NETWORKS["test"]))
+    signer = PSBTSigner(wallet, tdata.P2WPKH_PSBT, FORMAT_NONE)
+    for inp in signer.psbt.inputs:
+        inp.sighash_type = SIGHASH.ALL | SIGHASH.UNIFIED
+    assert signer.requested_sighash() == 0x21
+    assert signer.sighash_label() == (0x21, "Unified sighash")
+
+
+def test_unsafe_hash_is_rejected(tdata, m5stickv):
+    from embit.networks import NETWORKS
+    from embit.transaction import SIGHASH
+    from krux.key import Key, TYPE_SINGLESIG
+    from krux.wallet import Wallet
+    from krux.psbt import PSBTSigner
+    from krux.qr import FORMAT_NONE
+
+    wallet = Wallet(Key(tdata.TEST_MNEMONIC, TYPE_SINGLESIG, NETWORKS["test"]))
+    signer = PSBTSigner(wallet, tdata.P2WPKH_PSBT, FORMAT_NONE)
+    signer.psbt.inputs[0].sighash_type = SIGHASH.NONE
+    assert signer.unsignable_inputs() == [0]
+
+
+def test_trim_preserves_unified_declaration(tdata, m5stickv):
+    from embit.networks import NETWORKS
+    from embit.transaction import SIGHASH
+    from krux.key import Key, TYPE_SINGLESIG
+    from krux.wallet import Wallet
+    from krux.psbt import PSBTSigner
+    from krux.qr import FORMAT_NONE
+
+    wallet = Wallet(Key(tdata.TEST_MNEMONIC, TYPE_SINGLESIG, NETWORKS["test"]))
+    signer = PSBTSigner(wallet, tdata.P2WPKH_PSBT, FORMAT_NONE)
+    for inp in signer.psbt.inputs:
+        inp.sighash_type = SIGHASH.ALL | SIGHASH.UNIFIED
+    # No signing required to verify the PSBT field survives the trim operation.
+    trimmed = signer.psbt
+    assert all(inp.sighash_type == 0x21 for inp in trimmed.inputs)
