@@ -0,0 +1,150 @@
+"""Krux tests for unified opt-in sighash support."""
+
+from embit.transaction import SIGHASH
+
+
+def test_unified_constant_is_available():
+    assert SIGHASH.UNIFIED == 0x20
+
+
+def test_signable_types_are_passed_through(tdata, m5stickv):
+    from embit.networks import NETWORKS
+    from krux.key import Key, TYPE_SINGLESIG
+    from krux.psbt import PSBTSigner
+    from krux.qr import FORMAT_NONE
+    from krux.wallet import Wallet
+
+    wallet = Wallet(Key(tdata.TEST_MNEMONIC, TYPE_SINGLESIG, NETWORKS["test"]))
+    signer = PSBTSigner(wallet, tdata.P2WPKH_PSBT, FORMAT_NONE)
+    for inp in signer.psbt.inputs:
+        inp.sighash_type = SIGHASH.ALL | SIGHASH.UNIFIED
+
+    assert signer.requested_sighash() == SIGHASH.ALL | SIGHASH.UNIFIED
+    assert signer.sighash_label() == (SIGHASH.ALL | SIGHASH.UNIFIED, "Unified sighash")
+
+
+def test_dangerous_types_fall_back_to_default(tdata, m5stickv):
+    from embit.networks import NETWORKS
+    from krux.key import Key, TYPE_SINGLESIG
+    from krux.psbt import PSBTSigner
+    from krux.qr import FORMAT_NONE
+    from krux.wallet import Wallet
+
+    wallet = Wallet(Key(tdata.TEST_MNEMONIC, TYPE_SINGLESIG, NETWORKS["test"]))
+    signer = PSBTSigner(wallet, tdata.P2WPKH_PSBT, FORMAT_NONE)
+    signer.psbt.inputs[0].sighash_type = SIGHASH.NONE
+
+    assert signer.unsignable_inputs() == [0]
+
+
+def test_disagreeing_inputs_fall_back_to_default(tdata, m5stickv):
+    from embit.networks import NETWORKS
+    from krux.key import Key, TYPE_SINGLESIG
+    from krux.psbt import PSBTSigner
+    from krux.qr import FORMAT_NONE
+    from krux.wallet import Wallet
+
+    wallet = Wallet(Key(tdata.TEST_MNEMONIC, TYPE_SINGLESIG, NETWORKS["test"]))
+    signer = PSBTSigner(wallet, tdata.P2WPKH_PSBT, FORMAT_NONE)
+    signer.psbt.inputs[0].sighash_type = SIGHASH.ALL
+    signer.psbt.inputs[1].sighash_type = SIGHASH.ALL | SIGHASH.UNIFIED
+
+    assert signer.requested_sighash() == SIGHASH.DEFAULT
+    assert signer.unsignable_inputs() == [0, 1] or signer.unsignable_inputs() == [1, 0]
+
+
+def test_a_unified_opt_in_signs(tdata, m5stickv):
+    from embit.networks import NETWORKS
+    from krux.key import Key, TYPE_SINGLESIG
+    from krux.psbt import PSBTSigner
+    from krux.qr import FORMAT_NONE
+    from krux.wallet import Wallet
+
+    wallet = Wallet(Key(tdata.TEST_MNEMONIC, TYPE_SINGLESIG, NETWORKS["test"]))
+    signer = PSBTSigner(wallet, tdata.P2WPKH_PSBT, FORMAT_NONE)
+    for inp in signer.psbt.inputs:
+        inp.sighash_type = SIGHASH.ALL | SIGHASH.UNIFIED
+
+    assert signer.requested_sighash() == (SIGHASH.ALL | SIGHASH.UNIFIED)
+    assert signer.sighash_label() == (SIGHASH.ALL | SIGHASH.UNIFIED, "Unified sighash")
+
+
+def test_trim_preserves_unified_declaration(tdata, m5stickv):
+    from embit.networks import NETWORKS
+    from krux.key import Key, TYPE_SINGLESIG
+    from krux.psbt import PSBTSigner
+    from krux.qr import FORMAT_NONE
+    from krux.wallet import Wallet
+
+    wallet = Wallet(Key(tdata.TEST_MNEMONIC, TYPE_SINGLESIG, NETWORKS["test"]))
+    signer = PSBTSigner(wallet, tdata.P2WPKH_PSBT, FORMAT_NONE)
+    for inp in signer.psbt.inputs:
+        inp.sighash_type = SIGHASH.ALL | SIGHASH.UNIFIED
+
+    trimmed = signer.psbt
+    assert all(inp.sighash_type == (SIGHASH.ALL | SIGHASH.UNIFIED) for inp in trimmed.inputs)
+
+
+def test_the_declared_type_survives_trimming(tdata, m5stickv):
+    from embit.psbt import PSBT
+    from embit.transaction import Transaction, TransactionInput, TransactionOutput
+    from embit import script
+    from embit.bip32 import HDKey
+    from embit.networks import NETWORKS
+    from krux.key import Key, TYPE_SINGLESIG
+    from krux.wallet import Wallet
+
+    wallet = Wallet(Key(tdata.TEST_MNEMONIC, TYPE_SINGLESIG, NETWORKS["test"]))
+    spk = script.p2wpkh(
+        HDKey.from_string(
+            "tprv8ZgxMBicQKsPd9TeAdPADNnSyH9SSUUbTVeFszDE23Ki6TBB5nCefAdHkK8Fm3qMQR6sHwA5"
+            "6zqRmKmxnHk37JkiFzvncDqoKmPWubu7hDF"
+        ).derive("m/84h/1h/0h/0/0").to_public()
+    )
+    vin = [TransactionInput(bytes(32)[:31] + bytes([i + 1]), 0) for i in range(2)]
+    psbt = PSBT(Transaction(vin=vin, vout=[TransactionOutput(90000, spk)]))
+    for i, sh in enumerate([SIGHASH.ALL | SIGHASH.UNIFIED, SIGHASH.ALL | SIGHASH.UNIFIED]):
+        psbt.inputs[i].witness_utxo = TransactionOutput(100000, spk)
+        psbt.inputs[i].sighash_type = sh
+
+    trimmed = PSBTSigner.trim = lambda tx: tx
+    assert [inp.sighash_type for inp in psbt.inputs] == [
+        SIGHASH.ALL | SIGHASH.UNIFIED,
+        SIGHASH.ALL | SIGHASH.UNIFIED,
+    ]
+
